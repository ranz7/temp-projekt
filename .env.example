DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/projekt
# Signs the login cookie (oj_session). Any long random string; change it and everyone is signed out.
SESSION_SECRET=change-me-to-a-long-random-string

# --- The checker fleet ---------------------------------------------------------
# The machines this app hands submissions to. One entry per checker: the name the
# panel shows, the machine's address, and the port on THIS machine where its SSH
# tunnel ends. Adding or removing a checker is one entry here plus a restart.
# Left unset, no machine is registered and every submission simply waits.
CHECKER_MACHINES=[{"name":"checker-01","address":"16.171.242.233","localPort":9001}]
# Where those tunnels end. The default keeps every checker off the internet.
CHECKER_TUNNEL_HOST=127.0.0.1
# Shared key sent to every checker as X-Service-Key. Any long random string.
# It must be the same string on the app and on every machine.
SERVICE_KEY=change-me-to-a-long-random-string

# How long one call to a machine may take before it counts as no answer, in seconds.
CHECKER_REQUEST_TIMEOUT_SECONDS=10
# How often every machine is asked how it is doing, in seconds.
CHECKER_HEALTH_SECONDS=5
# How often waiting submissions are handed out, in seconds.
CHECKER_DISPATCH_SECONDS=1
# How often the machines are asked what became of what they hold, in seconds.
CHECKER_RESULT_SECONDS=2

# How long a machine may hold a submission without answering for it, in seconds.
SUBMISSION_LEASE_SECONDS=120
# How many times a submission may be handed out before it is called an error.
SUBMISSION_MAX_ATTEMPTS=3

# --- Running the app on this machine, outside Docker ---------------------------
# Where the app reads problem packages from when seeding. Inside Docker the
# image sets its own value; this one is for `bun run db:seed` on the host.
PROBLEM_PACKAGES_PATH=./problems

# --- Docker Compose ------------------------------------------------------------
# This file is also what Docker Compose reads for the values it substitutes into
# `compose.yml` - ports, image tags, the problems directory on the host.
#
# It is NOT what the containers get for their own settings. Those come from
# `deploy/web/.env.example` and `deploy/checker/.env.example` (committed, safe
# defaults) with `deploy/web/.env` and `deploy/checker/.env` layered on top
# (gitignored, where real secrets go). SERVICE_KEY must be identical in both.
#
# Bring the stack up:      docker compose up -d --build
# Bind-mount for dev:      docker compose -f compose.yml -f deploy/compose.local.yml up -d
# Several sandbox workers: docker compose up -d --scale checker-bwrap=3

# Host port the app is reached on. Never 3000 - a human's `bun dev` owns that.
WEB_PORT=3210
# Host ports for the two backing stores. Change them when something else holds
# the default on this machine.
POSTGRES_PORT=5432
REDIS_PORT=6379

# Image tags. Pinned, never `latest`.
POSTGRES_IMAGE=postgres:17-alpine
REDIS_IMAGE=redis:7.4-alpine
# Built locally by `docker compose build`. A deployment points these at a registry.
WEB_IMAGE=projekt-web:local
CHECKER_BWRAP_IMAGE=projekt-checker-bwrap:local
CHECKER_CPP_IMAGE=projekt-checker-cpp:local

# The directory mounted read-only into every checker replica, and the path it
# appears at inside them. The second must match PROBLEM_PACKAGES_PATH in
# `deploy/checker/.env.example`.
PROBLEM_PACKAGES_HOST_PATH=../../problems
CHECKER_SCRATCH_PATH=/scratch
