DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/projekt
# Signs the login cookie (oj_session). Any long random string; change it and everyone is signed out.
SESSION_SECRET=change-me-to-a-long-random-string

# Wake-up channel for the checkers. A submission is judged with or without it.
REDIS_URL=redis://127.0.0.1:6379
# Stream the checkers listen on. One entry names one waiting submission.
REDIS_STREAM=oj.submissions

# Shared key the checker workers send as X-Service-Key. Any long random string.
# Unset, every internal checker endpoint refuses every request.
SERVICE_KEY=change-me-to-a-long-random-string
# How long a claimed submission stays leased without a heartbeat, in seconds.
SUBMISSION_LEASE_SECONDS=60
# How many times a submission may be handed to a checker before it is called an error.
SUBMISSION_MAX_ATTEMPTS=3
# How old a wake-up may get before the sweeper announces the submission again, in seconds.
SUBMISSION_QUEUE_REPOST_SECONDS=10
# How often the standalone sweeper runs, in seconds.
SUBMISSION_SWEEP_SECONDS=10
