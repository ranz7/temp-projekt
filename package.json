{
  "name": "projekt",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.2.23",
  "engines": {
    "node": ">=22.23.0"
  },
  "scripts": {
    "dev": "next dev --turbopack --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --fix .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down --remove-orphans",
    "db:migrate": "tsx src/backend/database/scripts/db-migrate.ts",
    "db:seed": "tsx src/backend/database/seed.ts",
    "sweep": "tsx src/backend/modules/submission/scripts/run-sweeper.ts",
    "test": "vitest run --config vitest.unit.config.ts --no-file-parallelism",
    "test:integration": "vitest run --config vitest.integration.config.ts --no-file-parallelism"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.96.2",
    "@trpc/client": "11.16.0",
    "@trpc/server": "11.16.0",
    "@trpc/tanstack-react-query": "11.16.0",
    "dotenv": "^17.4.1",
    "drizzle-orm": "^0.45.2",
    "ioredis": "^6.0.0",
    "next": "^16.2.4",
    "postgres": "^3.4.9",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "server-only": "^0.0.1",
    "superjson": "^2.2.6",
    "zod": "^4.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.10",
    "@tailwindcss/postcss": "^4.2.2",
    "@types/node": "^22.15.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "drizzle-kit": "^0.31.10",
    "postcss": "^8.5.8",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
