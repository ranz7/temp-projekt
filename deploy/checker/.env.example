# Environment for both checker containers.
#
# This file is committed and loaded first, so `docker compose up` works with no
# setup at all. Everything in it is a safe local default or an obvious
# placeholder. To change a value, put it in `deploy/checker/.env` (gitignored,
# loaded after this file, wins). That is the file a deployment renders; real
# secrets live only there and never in git.

# The app the workers claim work from. `web` is the compose service name.
APP_URL=http://web:3000

# The shared key sent as X-Service-Key.
# It MUST be byte-for-byte the same value as SERVICE_KEY in
# `deploy/web/.env.example` (or in `deploy/web/.env`, if you set one).
# With a mismatch every claim is refused and no submission is ever judged.
SERVICE_KEY=local-development-service-key-change-me

# WORKER_ID is deliberately not set here. Unset, every replica names itself after
# its own container, which is what `--scale` needs. Setting it here would give
# every replica the same identity.
# WORKER_ID=

# Where the problem packages are mounted, read only, identically on every
# replica. Hidden test files are read from here and never sent over HTTP.
# Changing this means changing the mount target in `deploy/checker/compose.yml`
# too, which reads PROBLEM_PACKAGES_PATH from the repository-root `.env`.
PROBLEM_PACKAGES_PATH=/problems

# Per-job workspace, deleted when the job ends. A volume of its own per replica.
CHECKER_SCRATCH_PATH=/scratch

# The port each worker answers `GET /health` on, inside its own container.
# Nothing is published to the host, so every replica may use the same number.
CHECKER_HEALTH_PORT=8080

# Delay after the app answers "no work".
CHECKER_POLL_SECONDS=1
# Heartbeat interval. Must stay well under SUBMISSION_LEASE_SECONDS.
CHECKER_HEARTBEAT_SECONDS=20
# How long one call to the app may take.
CHECKER_REQUEST_TIMEOUT_SECONDS=15
# DEBUG makes the worker say what it is doing with every submission.
CHECKER_LOG_LEVEL=INFO

# Wake-up channel. Without it the workers poll and still judge everything.
REDIS_URL=redis://redis:6379
REDIS_STREAM=oj.submissions

# --- sandboxed Python checker only -------------------------------------------

# `none` runs submissions with no sandbox at all and is unsafe. Leave it as is.
JUDGE_SANDBOX=bwrap
BWRAP_PATH=/usr/bin/bwrap
CGROUP_ROOT=/sys/fs/cgroup
# The interpreter submissions run under, inside the sandbox. A property of the
# image rather than of the deployment.
PYTHON_PATH=/usr/local/bin/python3

# --- C++ checker only ---------------------------------------------------------

# OIOIOI is a separate, optional service. Left empty, the C++ worker still runs:
# it takes a C++ submission, gives it straight back to the queue and says why,
# without using up one of the submission's three attempts. Fill these in to
# actually judge C++.
OIOIOI_URL=
OIOIOI_TOKEN=
OIOIOI_CONTEST_ID=
OIOIOI_POLL_SECONDS=2
OIOIOI_REQUEST_TIMEOUT_SECONDS=10
# How long one submission may wait for an OIOIOI report before it goes back.
OIOIOI_POLL_TIMEOUT_SECONDS=600
