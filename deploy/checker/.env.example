# Environment for the checker container.
#
# This file is committed and loaded first, so `docker compose up` works with no
# setup at all. Everything in it is a safe local default or an obvious
# placeholder. To change a value, put it in `deploy/checker/.env` (gitignored,
# loaded after this file, wins). That is the file a deployment renders; real
# secrets live only there and never in git.
#
# Every name here is documented in `checkers/CONTRACT.md`, which wins.

# The shared key the app sends as X-Service-Key. Every call but `GET /health`
# carries it. It MUST be byte-for-byte the same value as SERVICE_KEY in
# `deploy/web/.env.example` (or in `deploy/web/.env`, if you set one).
# With a mismatch every judge call is refused and no submission is ever judged.
SERVICE_KEY=local-development-service-key-change-me

# The address the service listens on, inside the container's own network
# namespace. Nothing is published to the host, so this port is reachable from
# the app container and from nowhere else. On a real machine Ansible does the
# same and publishes it on 127.0.0.1 only, where the SSH tunnel picks it up.
CHECKER_BIND=0.0.0.0
CHECKER_PORT=8080

# How many submissions this machine judges at once.
CHECKER_CAPACITY=2
# How long a finished result stays readable, in seconds.
CHECKER_RESULT_TTL_SECONDS=900
# How long a running job may take to finish while the service is stopping.
CHECKER_SHUTDOWN_GRACE_SECONDS=30
# DEBUG makes the service say what it is doing with every submission.
CHECKER_LOG_LEVEL=INFO

# Where the problem packages are mounted, read only. Test data is read from here
# and never travels over HTTP. Changing this means changing the mount target in
# `deploy/checker/compose.yml` too, which reads it from the repository-root `.env`.
PROBLEM_PACKAGES_PATH=/problems

# Per-job workspace, deleted when the job ends. A volume of its own.
CHECKER_SCRATCH_PATH=/scratch

# The judge behind the service's seam, as `module:function`.
CHECKER_JUDGE=bwrap:run_judge

# `none` runs submissions with no sandbox at all and is unsafe. Leave it as is.
JUDGE_SANDBOX=bwrap
BWRAP_PATH=/usr/bin/bwrap
CGROUP_ROOT=/sys/fs/cgroup
# The interpreter a Python submission runs under, inside the sandbox. A property
# of the image rather than of the deployment.
PYTHON_PATH=/usr/local/bin/python3
