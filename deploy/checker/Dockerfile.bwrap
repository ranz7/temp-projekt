# One checker machine, as an image.
#
# It runs the HTTP service in `checkers/common`: the app asks it to judge a
# submission and asks it for the answer. It never calls the app and never fetches
# work by itself. The judge behind the service's seam is `checkers/bwrap`, which
# runs a submission inside bubblewrap with cgroup v2 caps on memory and process
# count.
#
# Problem packages are never baked in. Every container mounts a read-only
# directory instead, so no contest data lives in any image layer.

FROM python:3.13.14-slim-trixie

# bubblewrap is the sandbox, g++ compiles C++ submissions - our own checkers now
# do that. Nothing else is installed, so a submission finds no network client and
# no shell tooling to reach for.
RUN apt-get update \
 && apt-get install -y --no-install-recommends bubblewrap g++ \
 && rm -rf /var/lib/apt/lists/*

# The service and its judge need nothing third-party, so nothing is installed.
WORKDIR /app
COPY checkers/common ./common
COPY checkers/bwrap ./bwrap
COPY checkers/pyproject.toml ./pyproject.toml
COPY deploy/checker/entrypoint-bwrap.sh /usr/local/bin/entrypoint-bwrap.sh
RUN chmod +x /usr/local/bin/entrypoint-bwrap.sh

# Image-level defaults. Everything here is overridden from the service env file.
# This base image keeps its interpreter under /usr/local, which bubblewrap mounts
# read only along with the rest of /usr.
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHON_PATH=/usr/local/bin/python3
ENV BWRAP_PATH=/usr/bin/bwrap
ENV CHECKER_PORT=8080
ENV CHECKER_SCRATCH_PATH=/scratch
ENV PROBLEM_PACKAGES_PATH=/problems
ENV CHECKER_JUDGE=bwrap:run_judge

# One job at a time writes here and the directory is emptied when the job ends.
# A volume of its own, so a job's files never touch the image layer.
RUN mkdir -p /scratch
VOLUME ["/scratch"]

EXPOSE 8080

# Asks the service's own /health and passes only when it really answers: 200,
# contract version 2, and the machine saying it is healthy.
HEALTHCHECK --interval=5s --timeout=5s --start-period=15s --retries=3 \
  CMD python3 -c "import json,os,urllib.request; port=os.environ.get('CHECKER_PORT') or '8080'; body=json.load(urllib.request.urlopen('http://127.0.0.1:' + port + '/health', timeout=3)); raise SystemExit(0 if body.get('ok') and body.get('contractVersion') == 2 else 1)" || exit 1

# The script execs the service, so Python is PID 1 and SIGTERM reaches its own
# handler rather than a shell that would swallow it.
ENTRYPOINT ["/usr/local/bin/entrypoint-bwrap.sh"]
