# Environment for the web container and the sweeper container.
#
# This file is committed and loaded first, so `docker compose up` works with no
# setup at all. Everything in it is a safe local default or an obvious
# placeholder. To change a value, put it in `deploy/web/.env` (gitignored,
# loaded after this file, wins). That is the file a deployment renders; real
# secrets live only there and never in git.

# Turns off the query logger and the development-only error detail.
APP_ENV=production

# Where the app finds its database. `postgres` is the compose service name.
DATABASE_URL=postgres://postgres:postgres@postgres:5432/projekt
# Optional: a separate, higher-privilege URL used only to apply migrations.
# MIGRATION_DATABASE_URL=
# Set to `require` when the database is reached over the public internet.
# DATABASE_SSL=

# Signs the login cookie (oj_session). Any long random string.
# CHANGE THIS for anything other than your own laptop: whoever knows it can
# forge a signed-in session for any user.
SESSION_SECRET=local-development-session-secret-change-me

# The shared key the checker workers send as X-Service-Key.
# It MUST be byte-for-byte the same value as SERVICE_KEY in
# `deploy/checker/.env.example` (or in `deploy/checker/.env`, if you set one).
# With a mismatch every checker call is refused and no submission is ever judged.
SERVICE_KEY=local-development-service-key-change-me

# Wake-up channel for the checkers. A submission is judged with or without it:
# when Redis is down the sweeper announces the submission again.
REDIS_URL=redis://redis:6379
REDIS_STREAM=oj.submissions

# How long a claimed submission stays leased without a heartbeat, in seconds.
SUBMISSION_LEASE_SECONDS=60
# How many times a submission may be handed to a checker before it is an error.
SUBMISSION_MAX_ATTEMPTS=3
# How old a wake-up may get before the sweeper announces it again, in seconds.
SUBMISSION_QUEUE_REPOST_SECONDS=10
# How often the sweeper container runs, in seconds.
SUBMISSION_SWEEP_SECONDS=10

# Where the image keeps the problem packages it seeds from. This one is a
# property of the image, not of the deployment - leave it alone.
PROBLEM_PACKAGES_PATH=/app/problems
