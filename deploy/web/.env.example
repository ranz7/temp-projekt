# Environment for the app container and the loop-runner container. Both read the
# whole file: the app accepts submissions, the loop runner hands them out.
#
# This file is committed and loaded first, so `docker compose up` works with no
# setup at all. Everything in it is a safe local default or an obvious
# placeholder. To change a value, put it in `deploy/web/.env` (gitignored,
# loaded after this file, wins). That is the file a deployment renders; real
# secrets live only there and never in git.

# Turns off the query logger and the development-only error detail.
APP_ENV=production

# Where the app finds its database. `postgres` is the compose service name.
DATABASE_URL=postgres://postgres:postgres@postgres:5432/projekt
# Optional: a separate, higher-privilege URL used only to apply migrations.
# MIGRATION_DATABASE_URL=
# Set to `require` when the database is reached over the public internet.
# DATABASE_SSL=

# Signs the login cookie (oj_session). Any long random string.
# CHANGE THIS for anything other than your own laptop: whoever knows it can
# forge a signed-in session for any user.
SESSION_SECRET=local-development-session-secret-change-me

# The shared key sent to every checker as X-Service-Key.
# It MUST be byte-for-byte the same value as SERVICE_KEY in
# `deploy/checker/.env.example` (or in `deploy/checker/.env`, if you set one).
# With a mismatch every call is refused and no submission is ever judged.
SERVICE_KEY=local-development-service-key-change-me

# --- The checker fleet ---------------------------------------------------------
# The machines this app hands submissions to: the name the panel shows, the
# machine's address, and the port where its SSH tunnel ends. Unset, no machine is
# registered and every submission simply waits.
#
# Locally there is one checker and no tunnel: the app reaches the container
# directly on the compose network, so the host below is the service name and the
# port is the one the checker listens on.
CHECKER_MACHINES=[{"name":"checker-local","address":"checker","localPort":8080}]
CHECKER_TUNNEL_HOST=checker

# How long one call to a machine may take before it counts as no answer, in seconds.
CHECKER_REQUEST_TIMEOUT_SECONDS=10
# How often every machine is asked how it is doing, in seconds.
CHECKER_HEALTH_SECONDS=5
# How often waiting submissions are handed out, in seconds.
CHECKER_DISPATCH_SECONDS=1
# How often the machines are asked what became of what they hold, in seconds.
CHECKER_RESULT_SECONDS=2

# --- The queue -----------------------------------------------------------------
# How long a machine may hold a submission without answering for it, in seconds.
SUBMISSION_LEASE_SECONDS=120
# How many times a submission may be handed out before it is called an error.
SUBMISSION_MAX_ATTEMPTS=3

# --- The panel's batch ---------------------------------------------------------
# How far apart two submissions of a running batch are created, in milliseconds.
BENCHMARK_SUBMISSION_INTERVAL_MS=100

# PROBLEM_PACKAGES_PATH and BENCHMARK_SOLUTIONS_PATH are set by the image itself
# - /app/problems and /app/solutions - because both are properties of the image
# rather than of the deployment. Override them only if you mount those
# directories somewhere else.
