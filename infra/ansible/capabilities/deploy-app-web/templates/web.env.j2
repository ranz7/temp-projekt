# Managed by Ansible capability deploy-app-web. Mode 0600: it holds the database
# password, the session secret and the shared key.
#
# Every name here means what the repository-root `.env.example` says it means.

APP_ENV=production

# Postgres on the internal `oj-db` network. The app is the only thing on it.
DATABASE_URL={{ oj_database_url }}

# Signs the login cookie.
SESSION_SECRET={{ oj_session_secret }}

# Sent to every checker as X-Service-Key. The same string is on all
# {{ oj_checker_machines | length }} machines; a mismatch and every call is refused.
SERVICE_KEY={{ oj_service_key }}

# The fleet, rendered from the `checkers` group in infra/ansible/hosts.yml. One
# line, one JSON array, one entry per machine. `localPort` is the port on the
# tunnel container where that machine's SSH forward ends.
CHECKER_MACHINES={{ oj_checker_machines | to_json }}

# Where those ports live. `tunnels` is the tunnel container on this app's own
# Docker network, so the app needs no host networking and no checker address.
CHECKER_TUNNEL_HOST=tunnels

CHECKER_REQUEST_TIMEOUT_SECONDS={{ oj_checker_request_timeout_seconds }}
CHECKER_HEALTH_SECONDS={{ oj_checker_health_seconds }}
CHECKER_DISPATCH_SECONDS={{ oj_checker_dispatch_seconds }}
CHECKER_RESULT_SECONDS={{ oj_checker_result_seconds }}

SUBMISSION_LEASE_SECONDS={{ oj_submission_lease_seconds }}
SUBMISSION_MAX_ATTEMPTS={{ oj_submission_max_attempts }}

# A property of the image: the problem packages it seeds from at first start.
PROBLEM_PACKAGES_PATH=/app/problems
