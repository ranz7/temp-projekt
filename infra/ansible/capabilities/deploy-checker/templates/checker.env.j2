# Managed by Ansible capability deploy-checker. Mode 0600: it holds the shared key.
# Every name here is documented in checkers/CONTRACT.md.

SERVICE_KEY={{ oj_service_key }}

# The service binds every address inside its own container namespace. Docker
# publishes that port on 127.0.0.1 of this machine and nowhere else, so the
# checker is reachable only through the tunnel from the application machine.
CHECKER_BIND={{ oj_checker_bind }}
CHECKER_PORT={{ oj_checker_port }}

CHECKER_CAPACITY={{ oj_checker_capacity }}
CHECKER_RESULT_TTL_SECONDS={{ oj_checker_result_ttl_seconds }}
CHECKER_SHUTDOWN_GRACE_SECONDS={{ oj_checker_shutdown_grace_seconds }}
CHECKER_LOG_LEVEL={{ oj_checker_log_level }}

# Where this machine's copy of the problem packages is mounted, read only.
PROBLEM_PACKAGES_PATH={{ oj_checker_packages_path }}
# One job at a time writes here; the directory goes when the job ends.
CHECKER_SCRATCH_PATH={{ oj_checker_scratch_path }}

# The judge behind the seam. `none` would run submissions with no sandbox at all.
CHECKER_JUDGE=bwrap:run_judge
JUDGE_SANDBOX=bwrap
BWRAP_PATH=/usr/bin/bwrap
CGROUP_ROOT=/sys/fs/cgroup
PYTHON_PATH=/usr/local/bin/python3
