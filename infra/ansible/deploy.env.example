# Copy to `infra/ansible/deploy.env` and fill in. That file is gitignored and is
# the only place a real secret lives; nothing here reaches an image.
#
#   cp infra/ansible/deploy.env.example infra/ansible/deploy.env
#
# Plain KEY=VALUE, no quotes, no spaces around `=`, one line each.

# The shared key every call to a checker carries as X-Service-Key. The same
# string reaches the app and all thirteen machines. Any long random string:
#   openssl rand -hex 32
OJ_SERVICE_KEY=

# The password of the application machine's Postgres. Any long random string.
# Changing it after the first run does NOT change the password already stored in
# the database; drop the volume or change it in Postgres by hand.
OJ_POSTGRES_PASSWORD=

# Signs the login cookie. Change it and everyone is signed out.
OJ_SESSION_SECRET=

# The domain the site answers on, without a scheme, for example judge.example.com.
# Leave EMPTY to answer over plain HTTP on the machine's address instead. Point
# the domain's A record at the application machine, fill this in, run the same
# command again, and the proxy obtains a certificate by itself.
OJ_DOMAIN=

# Where Let's Encrypt writes about an expiring certificate. Required once
# OJ_DOMAIN is set, ignored while it is empty.
OJ_ACME_EMAIL=
